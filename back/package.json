{
  "name": "resenas-back",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/importarCatalogo.ts data/catalogo.json",
    "importar-catalogo": "tsx scripts/importarCatalogo.ts",
    "dataset:descargar": "tsx scripts/descargarDataset.ts",
    "db:seed:steam": "tsx scripts/importarCatalogo.ts data/dataset/games.json --limpiar-huerfanas"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "stream-json": "^3.7.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
