# Conexión a PostgreSQL (ver docker-compose.yml en la raíz)
DATABASE_URL="postgresql://resenas:resenas@localhost:5433/resenas?schema=public"

PORT=3000
# URL pública desde la que el navegador accede a la app (el front de Vite hace proxy de /api al back).
# Se usa como "realm" y "return_to" de Steam OpenID.
APP_URL="http://localhost:5173"

# Secreto para firmar la cookie de sesión. Cambiarlo en producción.
SESSION_SECRET="cambiar-este-secreto"
# RNF 3: expiración de sesión por inactividad (minutos)
SESSION_MINUTOS_INACTIVIDAD=30

# Clave de Steam Web API: https://steamcommunity.com/dev/apikey  (ver docs/integracion-steam-web-api.md)
# Es secreta: nunca subirla al repositorio.
STEAM_API_KEY=""
# RNF 1: tiempo máximo de espera de Steam (ms)
STEAM_TIMEOUT_MS=5000

# Modo simulado: la biblioteca y las horas se generan a partir del catálogo y se habilita
# un login de prueba. Se activa con STEAM_MOCK=true o si no hay STEAM_API_KEY. El login con Steam y el
# nombre/avatar del perfil siempre son reales.
STEAM_MOCK=true

# SteamIDs (separados por coma) que tienen rol Administrador
ADMIN_STEAM_IDS=""
